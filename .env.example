# EN: Copy this file to ".env" and adjust what you want.
#     All variables are optional: if one is missing, the value shown here is used.
# ES: Copiá este archivo a ".env" y ajustá lo que quieras.
#     Todas las variables son opcionales: si falta alguna se usa el valor indicado aquí.

# --- Language model (llama.cpp) / Modelo de lenguaje ---
# EN: Path to the .gguf file (relative to the project folder, or absolute)
# ES: Ruta al archivo .gguf (relativa a la carpeta del proyecto, o absoluta)
MODEL_PATH=models/qwen2.5-7b-instruct-q3_k_m.gguf
N_CTX=2048
MAX_TOKENS=512
TEMPERATURE=0.7
# EN: Preferred language of the answers (e.g. English) / ES: Idioma de las respuestas
ASSISTANT_LANGUAGE=español

# --- Conversation memory / Memoria de conversación ---
MEMORY_ENABLED=true
MEMORY_MAX_MESSAGES=10

# --- Voice (Whisper) / Voz ---
# Sizes / Tamaños: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base
# EN: Language code (es, en, ...) or "auto" to detect it
# ES: Código de idioma (es, en, ...) o "auto" para detectarlo
WHISPER_LANGUAGE=es
MAX_RECORDING_SECONDS=60

# --- Keyboard shortcuts / Atajos de teclado ---
HOTKEY_TEXT=ctrl+alt+t
HOTKEY_VOICE=ctrl+alt+g
HOTKEY_SELECTION=ctrl+alt+s
HOTKEY_SELECTION_INSTRUCTION=ctrl+alt+i
